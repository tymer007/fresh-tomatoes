# Copy to .env.local for local development (git-ignored). On Vercel: Project -> Settings -> Environment Variables.

# AI (Vercel AI Gateway) - same key as Agrosphere works. Free-tier model by default.
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite          # chat + advice writing
AI_VISION_MODEL=google/gemini-2.5-flash        # diagnosis when Roboflow is not configured

# Roboflow tomato disease model (copy the values from the old backend's environment).
# When both are set the pipeline is: Roboflow model -> AI advice. Without them the AI vision model does everything.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
# ROBOFLOW_API_URL=https://detect.roboflow.com
MIN_CONFIDENCE=0.5

# Free plan limits
FREE_SCANS_PER_DAY=3
FREE_CHATS_PER_DAY=3

# Data file (Vercel Blob, private). BLOB_READ_WRITE_TOKEN is added when you connect a Blob store (prefix BLOB).
BLOB_READ_WRITE_TOKEN=
ADMIN_KEY=                  # password for /api/status?download&key=... (downloads the Excel data file)
ALLOWED_ORIGINS=            # e.g. https://freshtomatoes.vercel.app,http://localhost:5173
